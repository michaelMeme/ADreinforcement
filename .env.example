# Cloudflare API Token with "Account / D1 / Read" permission only.
# In a Claude Code cloud session you do NOT set this: the token is saved as a
# network secret and the proxy injects it. Locally, copy this file to .env.
CF_API_TOKEN=

# Cloudflare account that owns the D1 database (32 hex chars).
CF_ACCOUNT_ID=ca104cafaabba123030f6b1916bb5153

# D1 database "youfu-ads-analysis"
CF_D1_DATABASE_ID=709ff200-b8b6-42dc-bc4b-9fb58af84197
